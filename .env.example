# 复制为 .env 并改成你自己的密码。.env 已在 .gitignore 中，不会被提交。
# 若不创建 .env，docker compose 会回退为 admin/admin（仅限本地演示）。

# ---------- Grafana ----------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
# 匿名免登录访问默认关闭；本地截图/演示想免登录时改为 true（只读 Viewer 角色）
GF_ANONYMOUS=false

# ---------- Nginx 演示站点 ----------
# 宿主机端口（默认 8080，被占用时改掉），仅绑定 127.0.0.1
NGINX_PORT=8080
